generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  CASHIER
}

enum MovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING
  REJECT
}

enum ReturnType {
  SALE
  PURCHASE
}

enum PaymentMethod {
  CASH
  QRIS
  CARD
  SPLIT
}

enum DocStatus {
  DRAFT
  POSTED
  VOID
}

/// UNPAID until its invoice (Sale) is made, then PAID. VOID = cancelled.
enum OrderStatus {
  UNPAID
  PAID
  VOID
}

enum TransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(160)
  passwordHash String    @db.VarChar(255)
  role         Role
  storeId      Int?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store      Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  orders     Order[]
  sales      Sale[]
  purchases  Purchase[]
  returns    ReturnDoc[]
  transfers  Transfer[]
  opnames    StockOpname[]
  shifts     Shift[]
  movements  StockMovement[]
  audits     AuditLog[]
  heldSales  HeldSale[]
  rejects    Reject[]
  deliveries Delivery[]

  @@index([storeId])
  @@index([role])
}

model Store {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(160)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(40)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  stocks        ItemStock[]
  prices        ItemPrice[]
  orders        Order[]
  sales         Sale[]
  purchases     Purchase[]
  returns       ReturnDoc[]
  movements     StockMovement[]
  transfersFrom Transfer[]      @relation("TransferFrom")
  transfersTo   Transfer[]      @relation("TransferTo")
  opnames       StockOpname[]
  shifts        Shift[]
  heldSales     HeldSale[]
  rejects       Reject[]
  deliveries    Delivery[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(160)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(40)
  tier      String   @default("Member") @db.VarChar(40)
  points    Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices        ItemPrice[]
  orders        Order[]
  sales         Sale[]
  heldSales     HeldSale[]
  deliveryNotes DeliveryNote[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(160)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(40)
  pic       String?  @db.VarChar(120)
  terms     String?  @db.VarChar(80)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  returns   ReturnDoc[]
  rejects   Reject[]
}

/// Master kendaraan — the delivery fleet. Columns keep the snake_case names
/// they were specified with; capacities are in kg.
model Vehicle {
  id               Int       @id @default(autoincrement())
  vehicleNo        String    @unique @map("vehicle_no") @db.VarChar(20)
  vehicleType      String    @map("vehicle_type") @db.VarChar(60)
  driver           String?   @db.VarChar(120)
  driverAssistance String?   @map("driver_assistance") @db.VarChar(120)
  minCapacity      Decimal?  @map("min_capacity") @db.Decimal(18, 2)
  maxCapacity      Decimal?  @map("max_capacity") @db.Decimal(18, 2)
  dueTax           DateTime? @map("due_tax") @db.Date
  dueStnk          DateTime? @map("due_stnk") @db.Date
  dueKir           DateTime? @map("due_kir") @db.Date
  active           Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  deliveries Delivery[]
}

model Category {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  items Item[]
}

model Unit {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now())

  baseItems Item[]     @relation("BaseUnit")
  itemUnits ItemUnit[]
}

model Item {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  barcode     String?  @unique @db.VarChar(60)
  name        String   @db.VarChar(180)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(400)
  categoryId  Int
  baseUnitId  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category        @relation(fields: [categoryId], references: [id])
  baseUnit   Unit            @relation("BaseUnit", fields: [baseUnitId], references: [id])
  itemUnits  ItemUnit[]
  stocks     ItemStock[]
  prices     ItemPrice[]
  orderItems OrderItem[]
  saleLines  SaleLine[]
  purchLines PurchaseLine[]
  retLines   ReturnLine[]
  movements  StockMovement[]
  transLines TransferLine[]
  opnLines   OpnameLine[]
  rejLines   RejectLine[]

  @@index([categoryId])
  @@index([name])
}

/// Alternative purchase/sale units. factor converts 1 of this unit into base units.
/// e.g. base = Gram, unit = "Sak 25 Kg", factor = 25000
model ItemUnit {
  id       Int     @id @default(autoincrement())
  itemId   Int
  unitId   Int
  label    String  @db.VarChar(80)
  factor   Decimal @db.Decimal(18, 4)
  isBase   Boolean @default(false)
  isBuying Boolean @default(true)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([itemId, label])
  @@index([itemId])
}

model ItemStock {
  id        Int      @id @default(autoincrement())
  itemId    Int
  storeId   Int
  stock     Decimal  @default(0) @db.Decimal(18, 4)
  minStock  Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([itemId, storeId])
  @@index([storeId])
}

/// Price per item per store. customerId NULL = general (non-member) price.
/// customerId set = special price dedicated to that member, in that store.
model ItemPrice {
  id            Int      @id @default(autoincrement())
  itemId        Int
  storeId       Int
  customerId    Int?
  price         Decimal  @db.Decimal(18, 4)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item     Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([itemId, storeId, customerId])
  @@index([storeId])
  @@index([customerId])
}

model Purchase {
  id         Int       @id @default(autoincrement())
  code       String    @unique @db.VarChar(40)
  supplierId Int
  storeId    Int
  userId     Int
  date       DateTime  @default(now())
  subtotal   Decimal   @default(0) @db.Decimal(18, 2)
  discount   Decimal   @default(0) @db.Decimal(18, 2)
  tax        Decimal   @default(0) @db.Decimal(18, 2)
  total      Decimal   @default(0) @db.Decimal(18, 2)
  status     DocStatus @default(POSTED)
  note       String?   @db.VarChar(255)
  createdAt  DateTime  @default(now())

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  store    Store          @relation(fields: [storeId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  lines    PurchaseLine[]
  rejects  Reject[]

  @@index([storeId, date])
  @@index([supplierId])
}

model PurchaseLine {
  id           Int     @id @default(autoincrement())
  purchaseId   Int
  itemId       Int
  unitLabel    String  @db.VarChar(80)
  factor       Decimal @db.Decimal(18, 4)
  qty          Decimal @db.Decimal(18, 4)
  baseQty      Decimal @db.Decimal(18, 4)
  pricePerUnit Decimal @db.Decimal(18, 4)
  pricePerBase Decimal @db.Decimal(18, 4)
  discount     Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @db.Decimal(18, 2)

  purchase    Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item        Item         @relation(fields: [itemId], references: [id])
  rejectLines RejectLine[]

  @@index([purchaseId])
  @@index([itemId])
}

/// Goods that arrived with a purchase in bad condition and are written off:
/// they leave stock for good (not sold, not returned to the supplier).
/// supplierId is copied from the purchase so supplier quality reports need no join.
model Reject {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(40)
  purchaseId Int
  supplierId Int
  storeId    Int
  userId     Int
  date       DateTime @default(now())
  /// Cost value written off, at what was paid per base unit.
  total      Decimal  @default(0) @db.Decimal(18, 2)
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  purchase Purchase     @relation(fields: [purchaseId], references: [id])
  supplier Supplier     @relation(fields: [supplierId], references: [id])
  store    Store        @relation(fields: [storeId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  lines    RejectLine[]

  @@index([storeId, date])
  @@index([supplierId, date])
  @@index([purchaseId])
}

/// One rejected purchase line. qty is in the item's base unit (the stock unit).
model RejectLine {
  id             Int     @id @default(autoincrement())
  rejectId       Int
  purchaseLineId Int
  itemId         Int
  qty            Decimal @db.Decimal(18, 4)
  unitCost       Decimal @db.Decimal(18, 4)
  total          Decimal @db.Decimal(18, 2)

  reject       Reject       @relation(fields: [rejectId], references: [id], onDelete: Cascade)
  purchaseLine PurchaseLine @relation(fields: [purchaseLineId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])

  @@index([rejectId])
  @@index([purchaseLineId])
  @@index([itemId])
}

/// Purchase order (PO) — what a customer orders at the kasir; the Sale's columns
/// without the payment, COGS and points, which only exist once it is invoiced.
/// Flow: PO -> pengiriman (surat jalan) -> invoice (Sale) for what the customer received.
/// Stock does not move here; it leaves with the invoice.
model Order {
  id             Int         @id @default(autoincrement())
  code           String      @unique @db.VarChar(40)
  storeId        Int
  customerId     Int?
  userId         Int
  date           DateTime    @default(now())
  subtotal       Decimal     @default(0) @db.Decimal(18, 2)
  discount       Decimal     @default(0) @db.Decimal(18, 2)
  tax            Decimal     @default(0) @db.Decimal(18, 2)
  total          Decimal     @default(0) @db.Decimal(18, 2)
  status         OrderStatus @default(UNPAID)
  /// Goods have left the store. Set by a delivery (pengiriman), cleared if it is cancelled.
  isDelivered    Boolean     @default(false) @map("is_delivered")
  /// The surat jalan that carried this order.
  deliveryNoteId Int?
  createdAt      DateTime    @default(now())

  store        Store         @relation(fields: [storeId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  deliveryNote DeliveryNote? @relation(fields: [deliveryNoteId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  /// The invoice made from it once delivered.
  sale         Sale?

  @@index([storeId, date])
  @@index([customerId])
  @@index([storeId, status, isDelivered])
  @@index([deliveryNoteId])
}

/// One ordered item, in the item's base unit, priced as resolved when ordered.
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  itemId    Int
  qty       Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)
  basePrice Decimal @db.Decimal(18, 4)
  discount  Decimal @default(0) @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)
  isMember  Boolean @default(false)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@index([itemId])
}

/// Invoice — the fixed transaction for what the customer received of one
/// delivered order. Stock leaves, COGS is snapshotted and points are earned here.
model Sale {
  id            Int           @id @default(autoincrement())
  code          String        @unique @db.VarChar(40)
  /// The PO this invoice bills; one invoice per PO.
  orderId       Int?          @unique
  storeId       Int
  customerId    Int?
  userId        Int
  shiftId       Int?
  date          DateTime      @default(now())
  subtotal      Decimal       @default(0) @db.Decimal(18, 2)
  discount      Decimal       @default(0) @db.Decimal(18, 2)
  tax           Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @default(0) @db.Decimal(18, 2)
  cogs          Decimal       @default(0) @db.Decimal(18, 2)
  paid          Decimal       @default(0) @db.Decimal(18, 2)
  change        Decimal       @default(0) @db.Decimal(18, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentMeta   Json?
  pointsEarned  Int           @default(0)
  status        DocStatus     @default(POSTED)
  createdAt     DateTime      @default(now())

  order    Order?      @relation(fields: [orderId], references: [id])
  store    Store       @relation(fields: [storeId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  user     User        @relation(fields: [userId], references: [id])
  shift    Shift?      @relation(fields: [shiftId], references: [id])
  lines    SaleLine[]
  returns  ReturnDoc[]

  @@index([storeId, date])
  @@index([customerId])
  @@index([shiftId])
}

/// Pengiriman — one vehicle trip taking purchase orders to their customers.
/// Driver names are copied from the vehicle when the trip is made, so a later
/// change in the vehicle master doesn't rewrite who drove it.
model Delivery {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(40)
  storeId          Int
  vehicleId        Int
  userId           Int
  date             DateTime @db.Date
  driver           String?  @db.VarChar(120)
  driverAssistance String?  @db.VarChar(120)
  note             String?  @db.VarChar(255)
  createdAt        DateTime @default(now())

  store   Store          @relation(fields: [storeId], references: [id])
  vehicle Vehicle        @relation(fields: [vehicleId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  notes   DeliveryNote[]

  @@index([storeId, date])
  @@index([vehicleId])
}

/// Surat jalan — one per customer on a delivery; its items are that customer's
/// orders merged per item. A walk-in order (no customer) gets a surat jalan of its own.
model DeliveryNote {
  id         Int    @id @default(autoincrement())
  code       String @unique @db.VarChar(40)
  deliveryId Int
  customerId Int?

  delivery Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([deliveryId])
  @@index([customerId])
}

model SaleLine {
  id        Int     @id @default(autoincrement())
  saleId    Int
  itemId    Int
  qty       Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)
  basePrice Decimal @db.Decimal(18, 4)
  unitCost  Decimal @default(0) @db.Decimal(18, 4)
  discount  Decimal @default(0) @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)
  isMember  Boolean @default(false)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@index([saleId])
  @@index([itemId])
}

model ReturnDoc {
  id         Int        @id @default(autoincrement())
  code       String     @unique @db.VarChar(40)
  type       ReturnType
  storeId    Int
  userId     Int
  saleId     Int?
  supplierId Int?
  date       DateTime   @default(now())
  total      Decimal    @default(0) @db.Decimal(18, 2)
  reason     String?    @db.VarChar(255)
  createdAt  DateTime   @default(now())

  store    Store        @relation(fields: [storeId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  sale     Sale?        @relation(fields: [saleId], references: [id])
  supplier Supplier?    @relation(fields: [supplierId], references: [id])
  lines    ReturnLine[]

  @@index([storeId, date])
}

model ReturnLine {
  id       Int     @id @default(autoincrement())
  returnId Int
  itemId   Int
  qty      Decimal @db.Decimal(18, 4)
  price    Decimal @db.Decimal(18, 4)
  total    Decimal @db.Decimal(18, 2)

  returnDoc ReturnDoc @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])

  @@index([returnId])
}

model Transfer {
  id          Int            @id @default(autoincrement())
  code        String         @unique @db.VarChar(40)
  fromStoreId Int
  toStoreId   Int
  userId      Int
  date        DateTime       @default(now())
  status      TransferStatus @default(SENT)
  note        String?        @db.VarChar(255)
  createdAt   DateTime       @default(now())

  fromStore Store          @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore   Store          @relation("TransferTo", fields: [toStoreId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  lines     TransferLine[]

  @@index([fromStoreId])
  @@index([toStoreId])
}

model TransferLine {
  id         Int     @id @default(autoincrement())
  transferId Int
  itemId     Int
  qty        Decimal @db.Decimal(18, 4)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@index([transferId])
}

model StockOpname {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(40)
  storeId   Int
  userId    Int
  date      DateTime  @default(now())
  status    DocStatus @default(DRAFT)
  note      String?   @db.VarChar(255)
  createdAt DateTime  @default(now())

  store Store        @relation(fields: [storeId], references: [id])
  user  User         @relation(fields: [userId], references: [id])
  lines OpnameLine[]

  @@index([storeId, date])
}

model OpnameLine {
  id          Int     @id @default(autoincrement())
  opnameId    Int
  itemId      Int
  systemQty   Decimal @db.Decimal(18, 4)
  physicalQty Decimal @db.Decimal(18, 4)
  diff        Decimal @db.Decimal(18, 4)
  value       Decimal @default(0) @db.Decimal(18, 2)

  opname StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  item   Item        @relation(fields: [itemId], references: [id])

  @@index([opnameId])
}

/// Kartu stok — every stock change lands here, with the resulting balance.
model StockMovement {
  id           Int          @id @default(autoincrement())
  itemId       Int
  storeId      Int
  userId       Int?
  type         MovementType
  qty          Decimal      @db.Decimal(18, 4)
  balanceAfter Decimal      @db.Decimal(18, 4)
  unitCost     Decimal      @default(0) @db.Decimal(18, 4)
  refType      String?      @db.VarChar(40)
  refId        Int?
  note         String?      @db.VarChar(255)
  createdAt    DateTime     @default(now())

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([itemId, storeId, createdAt])
  @@index([storeId, createdAt])
}

model Shift {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(40)
  storeId      Int
  userId       Int
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingCash  Decimal   @default(0) @db.Decimal(18, 2)
  closingCash  Decimal?  @db.Decimal(18, 2)
  expectedCash Decimal?  @db.Decimal(18, 2)
  difference   Decimal?  @db.Decimal(18, 2)
  note         String?   @db.VarChar(255)

  store Store  @relation(fields: [storeId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  sales Sale[]

  @@index([storeId, openedAt])
}

/// Parked / held sales — the cart payload is stored as JSON until resumed.
model HeldSale {
  id         Int      @id @default(autoincrement())
  label      String   @db.VarChar(120)
  storeId    Int
  userId     Int
  customerId Int?
  total      Decimal  @default(0) @db.Decimal(18, 2)
  payload    Json
  createdAt  DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([storeId])
}

model Setting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(80)
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
